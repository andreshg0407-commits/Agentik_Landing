# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Seed-time credentials (never commit real values) ─────────────────────────
# These variables are used ONLY by `prisma db seed`.
# Set them in your local .env or pass them inline at seed time.
# If absent, the seed skips user/credential creation safely.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_ARKETOPS_ADMIN_PASSWORD=
SEED_ARKETOPS_VIEWER_PASSWORD=

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Required for Marketing Studio asset uploads (Foto Estudio, Biblioteca, Video).
# Obtain from Cloudflare Dashboard → R2 → API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base URL for the R2 bucket (no trailing slash).
# Can be a custom domain, Workers route, or r2.dev public URL.
R2_PUBLIC_BASE_URL=

# ── R2 Upload Controls ──────────────────────────────────────────────────────
# Feature flag for Luca submit uploads (default: false).
ENABLE_R2_UPLOAD=false
# Object key prefix for Luca pipeline (default: uploads).
R2_PREFIX=uploads
# Maximum file size in MB (default: 20).
MAX_UPLOAD_MB=20

# ── n8n Callback Security ───────────────────────────────────────────────────
# Required in preview/production. Local dev allows open callbacks when unset.
STUDIO_N8N_WEBHOOK_SECRET=
